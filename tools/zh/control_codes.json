      "layer": "string",
      "bytes": "52-5E",
      "rule": "SpecialCharacters table; CTXT 5D enters Huffman bitstream"
    },
    {
      "layer": "string",
      "bytes": "00-4C",
      "rule": "legacy rejects low bytes except ZH 0E pair; proposed leads need new decoder"
    },
    {
      "layer": "zh_descriptor",
      "bytes": "0A",
      "parameters": "LE16 start + LE16 end, fixed bank80"
    },
    {
      "layer": "zh_e1",
