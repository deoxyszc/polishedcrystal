      "layer": "menu string",
      "bytes": "0A",
      "parameters": "style|80, length high7|80, length low7|80; bounded character payload; followed by original @",
      "rule": "PlaceString adapter; private E1/dialogue 0A remain separate contexts"
    }
  ],
