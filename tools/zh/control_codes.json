      "parameters": "two high-bit-set 7-bit glyph ID payloads"
    },
    {
      "layer": "zh_private",
      "bytes": "0D",
      "parameters": "bank + LE16 RAM address"
    },
    {
      "layer": "zh_private",
      "bytes": "0B/0C",
      "parameters": "none; dynamic player/rival"
    },
    {
      "layer": "zh_private",
      "bytes": "02/52/53/54/55/56/57/59",
      "parameters": "none; WAIT/DONE/AT/PROMPT/CONT/NEXT/LINE/PARA; AT ends a pair run, not necessarily dialogue"
    },
    {
      "layer": "compression",
      "bytes": "5D",
      "rule": "Huffman bitstream; decoded 52/53/54 terminate; never scan compressed bytes as controls"
    },
